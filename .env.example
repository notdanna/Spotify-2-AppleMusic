# ==============================================================================
# CONFIGURACIÓN DE SPOTIFY A APPLE MUSIC SYNC
# ==============================================================================
# Copia este archivo a '.env' y completa tus credenciales.
#
# 1. SPOTIFY (100% Gratuito y permanente):
#    Ve a https://developer.spotify.com/dashboard
#    - Inicia sesión con tu cuenta de Spotify.
#    - Haz clic en "Create App".
#    - Nombre: Sync, Redirect URI: http://localhost (no importa para client credentials).
#    - Copia el Client ID y Client Secret aquí:
SPOTIFY_CLIENT_ID=tu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret_aqui

# 2. APPLE MUSIC (Obtenido desde music.apple.com usando DevTools F12):
#    - Inicia sesión en https://music.apple.com
#    - Abre DevTools (Cmd+Option+I o Ctrl+Shift+I) -> pestaña Network (Red).
#    - Busca una petición a 'amp-api.music.apple.com' o 'buy.music.apple.com'.
#    - Copia los valores correspondientes de Request Headers:
APPLE_MUSIC_TOKEN="Bearer eyJhbGciOi..."
APPLE_MUSIC_MEDIA_USER_TOKEN="tu_media_user_token"
APPLE_MUSIC_COOKIES="tu_cookie_completa"
APPLE_MUSIC_STOREFRONT="MX"
# Código de país de 2 letras (ISO): MX (México), ES (España), US (Estados Unidos), etc.

# 3. PLAYLISTS A SINCRONIZAR:
#    Formato: ID_O_URL_SPOTIFY=Nombre en Apple Music
#    Puedes separar múltiples playlists con punto y coma ';'
#    Ejemplo:
#    PLAYLISTS="37i9dQZF1DXcBWIGoYBM5M=Mi Playlist Favorita; https://open.spotify.com/playlist/abc123xyz=Mis Éxitos"
PLAYLISTS=""

# 4. OPCIONAL - MODO BUCLE / SERVIDOR:
#    Intervalo en segundos para cuando se corre con --daemon (3600 = 1 hora)
SYNC_INTERVAL=3600

# 5. OPCIONAL - NOTIFICACIONES DISCORD / WEBHOOK:
#    Si colocas un Webhook de Discord, te avisará cuando se sincronicen canciones
#    o si el token de Apple Music expira.
DISCORD_WEBHOOK_URL=""
